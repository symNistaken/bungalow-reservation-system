# Email Configuration
# Gmail SMTP Settings for Sending Notifications

# Your Gmail address (that will send the emails)
EMAIL_SENDER=your-email@gmail.com

# Gmail App Password (NOT your regular password)
# How to generate: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your-app-password-here

# Admin email (who receives notifications about new reservations)
ADMIN_EMAIL=admin@bungalow.com

# Optional: Custom SMTP Server settings
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587

# Required: choose your own admin password; no default login is provided.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SECRET_KEY=
APP_ENV=development
# Production requires HTTPS and shared rate-limit storage.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# --- Branding (set per customer business) ---
BUSINESS_NAME=Bungalow Rezervasyon
# Public URL of this deployment; used in admin e-mail links.
APP_BASE_URL=http://localhost:5000
# Shown to guests in e-mails; defaults to ADMIN_EMAIL.
# CONTACT_EMAIL=info@example.com
# Comma-separated bungalow names; only these are accepted by the form/API.
BUNGALOWS=Akasya,Ihlamur,Meşe,Palmiye,Zeytin

# Behind a reverse proxy (Render, nginx) set to the number of proxies (Render: 1).
# Leave 0 when the app is reached directly, otherwise clients can spoof their IP.
TRUST_PROXY_HOPS=0

# --- Kozalak Bungalov satış sayfası (/kozalak) ve demo ---
# Demo modunda ziyaretçilere mail gitmez ve yönetici şifresi ekranda gösterilir. Gerçek müşteri kurulumunda KAPALI tutun.
# DEMO_MODE=true
# SALES_EMAIL=berkayseyman@gmail.com
# SALES_WHATSAPP=905340806421
# SITE_PRICE_FROM=7.500
