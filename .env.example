# Email Configuration
# Gmail SMTP Settings for Sending Notifications

# Your Gmail address (that will send the emails)
EMAIL_SENDER=your-email@gmail.com

# Gmail App Password (NOT your regular password)
# How to generate: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your-app-password-here

# Admin email (who receives notifications about new reservations)
ADMIN_EMAIL=admin@bungalow.com

# Optional: Custom SMTP Server settings
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587

# Required: choose your own admin password; no default login is provided.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SECRET_KEY=
APP_ENV=development
# Production requires HTTPS and shared rate-limit storage.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
